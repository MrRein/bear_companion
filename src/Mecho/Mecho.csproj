<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>Mecho</AssemblyName>
    <RootNamespace>Mecho</RootNamespace>
    <ApplicationIcon>mecho.ico</ApplicationIcon>
    <Version>0.1.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="mecho.ico" />
    <!-- Pixeled (OmegaPC777, FontStruct Non-Commercial License) и резервен Pixelify Sans
         (SIL Open Font License, виж fonts/OFL.txt, с добавени кирилски О и П). -->
    <Resource Include="fonts\*.ttf" />
    <!-- Рисунките стоят до .exe файла, за да могат да се сменят без компилиране. -->
    <None Include="..\..\assets\**\*" Link="assets\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>

</Project>
